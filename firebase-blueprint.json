      "description": "User savings goals and emergency funds collection"
    }
  },
  "entities": {
    "Account": {
      "title": "Account",
      "description": "Financial account entity for Milestone 17 Finance Module",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique account ID" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100, "description": "Account name" },
        "type": {
          "type": "string",
          "enum": ["cash", "bank", "credit_card", "savings", "investment", "digital_wallet", "crypto", "custom"],
          "description": "Account type"
        },
        "balance": { "type": "number", "description": "Current balance" },
        "currency": { "type": "string", "maxLength": 10, "description": "Currency ISO code e.g. USD" },
        "accountNumberLast4": { "type": "string", "maxLength": 10, "description": "Last 4 digits" },
        "institution": { "type": "string", "maxLength": 100, "description": "Financial institution name" },
        "color": { "type": "string", "maxLength": 30, "description": "Account color code" },
        "icon": { "type": "string", "maxLength": 50, "description": "Lucide icon key" },
        "creditLimit": { "type": "number", "description": "Optional credit limit" },
        "interestRate": { "type": "number", "description": "Optional APR or interest rate" },
        "isHidden": { "type": "boolean", "description": "Hidden flag" },
        "isArchived": { "type": "boolean", "description": "Archived flag" },
        "createdAt": { "type": "string", "description": "Creation ISO date" },
        "updatedAt": { "type": "string", "description": "Update ISO date" }
      },
      "required": ["id", "userId", "name", "type", "balance", "currency", "createdAt", "updatedAt"]
    },
