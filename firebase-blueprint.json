        "payee": { "type": "string", "maxLength": 100 },
        "dueDate": { "type": "string", "description": "Due date YYYY-MM-DD" },
        "recurrence": {
          "type": "string",
          "enum": ["one_time", "monthly", "weekly", "yearly"],
