rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidTask(data) {
      return data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.status in ['inbox', 'todo', 'in_progress', 'done', 'archived']
        && data.priority in ['none', 'low', 'medium', 'high', 'urgent']
        && data.userId is string;
    }

    function isValidHabit(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 200
        && data.userId is string
        && data.status in ['active', 'paused', 'archived'];
    }

    function isValidHabitLog(data) {
      return data.habitId is string
        && data.userId is string
        && data.date is string
        && data.status in ['completed', 'partial', 'skipped', 'missed'];
    }

    function isValidGoal(data) {
      return data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.userId is string
        && data.category is string
        && data.priority in ['low', 'medium', 'high', 'urgent']
        && data.status in ['not_started', 'in_progress', 'completed', 'paused', 'archived'];
    }

    function isValidProject(data) {
      return data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.userId is string
        && data.status in ['planning', 'active', 'on_hold', 'completed', 'archived']
        && data.priority in ['low', 'medium', 'high', 'urgent'];
    }

    function isValidMilestone(data) {
      return data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.userId is string
        && data.projectId is string
        && data.status in ['pending', 'in_progress', 'completed'];
    }

    function isValidEvent(data) {
      return data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.userId is string
        && data.startDate is string
        && data.endDate is string;
    }

    function isValidPlanner(data) {
      return data.userId is string
        && data.date is string;
    }

    function isValidJournal(data) {
      return data.title is string
        && data.title.size() <= 300
        && data.userId is string;
    }

    function isValidNote(data) {
      return data.title is string
        && data.title.size() <= 300
        && data.userId is string;
    }

    function isValidFolder(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.userId is string;
    }

    function isValidTag(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 50
        && data.userId is string;
    }

    function isValidAccount(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.userId is string
        && data.type in ['cash', 'bank', 'credit_card', 'savings', 'investment', 'digital_wallet', 'crypto', 'custom'];
    }

    function isValidTransaction(data) {
      return data.userId is string
        && data.amount is number
        && data.type in ['income', 'expense', 'transfer']
        && data.category is string
        && data.accountId is string
        && data.date is string;
    }

    function isValidBudget(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.userId is string
        && data.category is string
        && data.amountLimit is number
        && data.period in ['monthly', 'weekly'];
    }

    function isValidBill(data) {
      return data.title is string
        && data.title.size() > 0
        && data.title.size() <= 100
        && data.userId is string
        && data.amount is number
        && data.dueDate is string
        && data.status in ['unpaid', 'paid', 'overdue'];
    }

    function isValidSavingsGoal(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.userId is string
        && data.targetAmount is number;
    }

    function isValidAIConversation(data) {
      return data.userId is string
        && data.title is string;
    }

    function isValidAIMemory(data) {
      return data.userId is string
        && data.category is string
        && data.key is string;
    }

    function isValidAIPreference(data) {
      return data.userId is string;
    }

    function isValidAIPrompt(data) {
      return data.userId is string
        && data.name is string;
    }

    function isValidAIWorkflow(data) {
      return data.userId is string
        && data.name is string;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Cloud-First Personal OS 2.0: /users/{userId} and all subcollections (/profile, /tasks, /finance, etc.)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidTask(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidTask(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /habits/{habitId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidHabit(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidHabit(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /habit_logs/{logId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidHabitLog(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidHabitLog(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /goals/{goalId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidGoal(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidGoal(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /projects/{projectId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidProject(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidProject(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /milestones/{milestoneId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidMilestone(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidMilestone(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /events/{eventId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidEvent(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidEvent(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /planner/{plannerId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidPlanner(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidPlanner(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /journals/{journalId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidJournal(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidJournal(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /notes/{noteId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidNote(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidNote(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /folders/{folderId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidFolder(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidFolder(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /tags/{tagId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidTag(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidTag(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /accounts/{accountId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidAccount(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidAccount(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /transactions/{transactionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidTransaction(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidTransaction(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /budgets/{budgetId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidBudget(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidBudget(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /bills/{billId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidBill(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidBill(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /savings_goals/{goalId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidSavingsGoal(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidSavingsGoal(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /ai_conversations/{conversationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidAIConversation(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidAIConversation(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /ai_memory/{memoryId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidAIMemory(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidAIMemory(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /ai_preferences/{preferenceId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidAIPreference(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidAIPreference(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /ai_prompts/{promptId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidAIPrompt(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidAIPrompt(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /ai_workflows/{workflowId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidAIWorkflow(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid && isValidAIWorkflow(request.resource.data);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
